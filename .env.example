# Local development settings. Copy to .env (git-ignored) and load it in the
# run target, for example with `dotenv: ['.env']` in the Taskfile.
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

# The local Postgres from the README; see docs/configuration.md for the rest.
# The vault (cmd/vault):
DATABASE_DSN=postgres://postgres@localhost:5432/vault?sslmode=disable
GRPC_PORT=9091
ENVIRONMENT=dev
# The workflow service (cmd/workflow) uses its own database and port:
# DATABASE_DSN=postgres://postgres@localhost:5432/workflow?sslmode=disable
# GRPC_PORT=9193
# VAULT_ADDR=localhost:9091
